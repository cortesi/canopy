-- Explicit targets keep queries valid from the automation root and modal focus.
local function gym(method: string, ...: any)
    local node = canopy.find_node("**/markdown_gym")
    if not node then error("the Markdown gym is not mounted") end
    return canopy.call_exact(node, "markdown_gym::" .. method, ...)
end
local function reader(method: string, ...: any)
    local node = canopy.find_node("**/markdown")
    if not node then error("the document controller is not mounted") end
    return canopy.call_exact(node, "markdown::" .. method, ...)
end
local function cells(method: string, ...: any)
    local node = canopy.find_node("**/markdown_inspector/**/table_view")
    if not node then error("the shared table inspector is not mounted") end
    return canopy.call_exact(node, "table_view::" .. method, ...)
end

-- Every wait observes explicit worker/publication state. No guessed frame count.
local function ready()
    canopy.wait_for(function()
        return gym("ready")
    end, 5000)
    canopy.prepare()
    canopy.assert(gym("accepted_revision") == gym("displayed_revision"), "the current accepted revision is displayed")
end
local function close_inspector()
    canopy.send_key("Escape")
    canopy.wait_for(function() return not gym("inspector_open") end, 5000)
    canopy.prepare()
end
local function host_action(after)
    canopy.wait_for(function()
        gym("collect_host")
        return gym("host_actions") > after
    end, 5000)
end

ready()
gym("focus_reader")
canopy.assert(gym("focused"), "the reading surface accepts focus")
canopy.assert(canopy.screen_text():find("A reader for", 1, true) ~= nil, "the realistic fixture is rendered")
local epoch = gym("epoch")
local revision = gym("displayed_revision")

-- An external link opens an inspectable modal. Explicit Open reaches only the
-- recording host, and close restores the same reading surface.
reader("next_object", 1)
reader("activate")
canopy.wait_for(function() return gym("inspector_ready") end, 5000)
local actions = gym("host_actions")
canopy.send_key("Ctrl+o")
host_action(actions)
canopy.assert(gym("last_url") == "https://example.com/releases?channel=stable#notes", "Open records the frozen resolved URL")
canopy.assert(gym("last_revision") == revision, "the host action pins the displayed revision")
close_inspector()
canopy.assert(gym("focused"), "closing the inspector restores focus")

-- Object order follows source order: two more links, then the code card and
-- table card. Hidden lines and cells remain available through their inspectors.
reader("next_object", 1)
reader("next_object", 1)
reader("next_object", 1)
reader("activate")
canopy.wait_for(function() return gym("inspector_ready") end, 5000)
actions = gym("host_actions")
canopy.send_key("Ctrl+y")
host_action(actions)
canopy.assert(gym("last_copy"):find("acknowledge(revision);", 1, true) ~= nil, "Copy Block includes lines omitted from the code card")
canopy.assert(gym("last_copy"):sub(-2) == "}\n", "Copy Block retains the final newline")
close_inspector()

reader("next_object", 1)
reader("activate")
canopy.wait_for(function() return gym("inspector_ready") end, 5000)
actions = gym("host_actions")
canopy.send_key("Shift+Right")
canopy.send_key("Shift+Down")
canopy.send_key("y")
host_action(actions)
canopy.assert(gym("last_copy") == "Source\tready\nParse\tready\n", "table rectangle copy uses full cells and TSV framing: " .. string.format("%q",gym("last_copy")))
cells("goto", 1, 3)
canopy.send_key("Enter")
canopy.wait_for(function() return gym("inspector_ready") and canopy.find_node("**/markdown_inspector/**/markdown_source") ~= nil end, 5000)
actions = gym("host_actions")
canopy.send_key("Ctrl+y")
host_action(actions)
canopy.assert(gym("last_copy") == "CRLF, tabs, and final newlines remain exact", "cell detail copies the complete original value")
canopy.send_key("Escape")
canopy.prepare()
close_inspector()

-- A wikilink names a note for the host. Activating its search match inspects
-- it, and Open records a local follow rather than a browser request.
gym("search", "Verber")
ready()
reader("search_next", 1)
reader("activate")
canopy.wait_for(function() return gym("inspector_ready") end, 5000)
actions = gym("host_actions")
canopy.send_key("Ctrl+o")
host_action(actions)
canopy.assert(gym("last_local") == "work/verber", "Open follows a wikilink locally: " .. gym("last_local"))
close_inspector()
reader("clear_search")
ready()

-- Search includes payload omitted from inline table and source-card previews.
gym("search", "hidden-card-needle")
ready()
canopy.assert(gym("matches") >= 2, "rendered search includes hidden card payloads")
reader("clear_search")
ready()
canopy.send_key("Ctrl+r")
ready()
canopy.assert(gym("view") == "source", "CtrlR activates Source")
canopy.assert(gym("epoch") == epoch, "view switching retains the source epoch")
canopy.assert(gym("displayed_revision") == revision, "view switching retains the source revision")
canopy.assert(gym("focused"), "view switching preserves the focused reading region")
canopy.send_key("Ctrl+r")
ready()
canopy.assert(gym("view") == "rendered", "CtrlR returns to Rendered")

-- Original CRLF, a tab, UTF-8, and the final newline reach the recording host.
gym("exact_source")
ready()
actions = gym("host_actions")
reader("copy_source")
host_action(actions)
canopy.assert(gym("last_copy") == "# Exact source\r\n\r\n\tlet label = \"界\";\r\nfinal line\r\n", "Source copy preserves exact accepted bytes")

-- Controlled streaming keeps a literal trailing table until a following block.
gym("begin_stream")
reader("set_view_type", "rendered")
ready()
gym("focus_reader")
local stream_epoch = gym("epoch")
gym("append_chunk")
ready()
gym("append_chunk")
ready()
gym("append_chunk")
ready()
canopy.assert(canopy.screen_text():find("| Phase |", 1, true) ~= nil, "the open trailing table remains literal Markdown")
canopy.send_key("Home")
canopy.prepare()
canopy.assert(reader("follow_state") == "paused", "an actual scroll pauses follow")
gym("append_chunk")
ready()
canopy.assert(reader("follow_state") == "paused", "background publication preserves paused follow")
canopy.assert(gym("epoch") == stream_epoch, "append keeps the source epoch")
canopy.assert(gym("focused"), "background publication preserves focus")
reader("follow")
canopy.prepare()
canopy.assert(canopy.screen_text():find("Published tail", 1, true) ~= nil, "follow reveals the newly published tail")
gym("append_chunk")
gym("finish")
ready()
canopy.assert(canopy.screen_text():find("finished", 1, true) ~= nil, "Finish records EOF interpretation")

gym("begin_stream")
ready()
gym("abort")
ready()
canopy.assert(canopy.screen_text():find("aborted", 1, true) ~= nil, "abort retains accepted output with a visible outcome")
gym("replace")
ready()
canopy.assert(gym("epoch") ~= stream_epoch, "replace creates a new epoch")
gym("partial_source")
ready()
canopy.assert(not gym("rendered_available"), "a partial file prefix cannot activate Rendered")
gym("replace")
ready()
canopy.send_key("Ctrl+l")
canopy.send_key("Down")
canopy.send_key("Enter")
ready()
gym("glyphs")
ready()
gym("theme")
canopy.prepare()
canopy.assert(canopy.screen_text():find("ASCII", 1, true) ~= nil, "the geometry preset remains visible")
