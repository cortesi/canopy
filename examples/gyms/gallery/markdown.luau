-- Explicit targets keep queries valid from the automation root and modal focus.
local function gym(method: string, ...: any)
    local node = canopy.find_node("**/markdown_gym")
    if not node then error("the Markdown gym is not mounted") end
    return canopy.call_exact(node, "markdown_gym::" .. method, ...)
end
local function reader(method: string, ...: any)
    local node = canopy.find_node("**/markdown")
    if not node then error("the document controller is not mounted") end
    return canopy.call_exact(node, "markdown::" .. method, ...)
end
local function cells(method: string, ...: any)
    local node = canopy.find_node("**/markdown_inspector/**/table_view")
    if not node then error("the shared table inspector is not mounted") end
    return canopy.call_exact(node, "table_view::" .. method, ...)
end

-- A representative matrix; capture success is separate from visual review.
local shots = {}
local function ready()
    canopy.wait_for(function() return gym("ready") end, 5000)
    canopy.prepare()
end
local function inspector_ready()
    canopy.wait_for(function() return gym("inspector_ready") end, 5000)
    canopy.prepare()
end
local function close_inspector()
    canopy.send_key("Escape")
    canopy.wait_for(function() return not gym("inspector_open") end, 5000)
    ready()
end
local function close_cell_detail()
    canopy.send_key("Escape")
    canopy.wait_for(function()
        return gym("inspector_ready")
            and canopy.find_node("**/markdown_inspector/**/markdown_source") == nil
            and canopy.find_node("**/markdown_inspector/**/table_view") ~= nil
    end, 5000)
    canopy.prepare()
end
local function shot(id, title, caption)
    table.insert(shots, { id = id, title = title, caption = caption, capture = canopy.capture() })
end
