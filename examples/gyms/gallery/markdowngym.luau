shot("source-inspector", "Pinned source", "The source inspector pins the displayed revision and retains original syntax.")
close_inspector()
reader("set_view_type", "source")
ready()
shot("source", "Source presentation", "A sibling Source surface over the same accepted bytes and epoch.")
gym("begin_stream")
reader("set_view_type", "rendered")
ready()
gym("append_chunk")
ready()
shot("receiving-code", "Receiving code", "A receiving code card is visible while earlier content remains interactive.")
gym("append_chunk")
gym("append_chunk")
ready()
